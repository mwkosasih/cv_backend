# Gemini API Key (Get yours at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Primary model (e.g. gemini-3.5-flash-lite, gemini-2.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional secondary fallback models (if primary model fails or is unavailable)
# If left empty or unset, no secondary models will be appended
GEMINI_MODEL_2=gemini-2.5-flash
GEMINI_MODEL_3=gemini-2.0-flash
GEMINI_MODEL_4=gemini-1.5-flash

# Port for local web server
PORT=8082
